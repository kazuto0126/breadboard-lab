    { "number": 4, "name": "NC", "role": "nc" },
    { "number": 5, "name": "VCC", "role": "power" },
    { "number": 6, "name": "R9(1)", "role": "input" },
    { "number": 7, "name": "R9(2)", "role": "input" },
    { "number": 8, "name": "QC", "role": "output" },
